rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is signed in as themselves
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the user has a specific role (requires reading their user doc)
    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Specialized role checks
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isTeacher() {
      // Teachers must be approved to perform teacher actions
      return hasRole('teacher') && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for project details etc)
      allow read: if isAuthenticated();
      
      // Creation: 
      // 1. Must be the user themselves
      // 2. Cannot create an Admin account directly (must be promoted)
      // 3. Teachers start as unapproved (enforced by validation, but rules safe-guard)
      // Note: We check if the incoming data matches the constraints
      allow create: if isOwner(userId)
        && request.resource.data.role != 'admin' // Prevent signup as admin
        && (
          request.resource.data.role != 'teacher' || 
          request.resource.data.isApproved == false
        );

      // Updates:
      // 1. Admins can update any user (Promote, Approve, Deactivate)
      // 2. Users can update their own profile, BUT cannot change their Role or Approval status
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role // Cannot change own role
        && request.resource.data.isApproved == resource.data.isApproved // Cannot approve self
        && request.resource.data.isActive == resource.data.isActive // Cannot reactivate self if suspended
      );
      
      // Delete: Only Admins can delete users
      allow delete: if isAdmin();
    }

    // --- Projects Collection ---
    match /projects/{projectId} {
      // Public Read: Projects are meant to be showcased
      // Optionally restrict to authenticated if it's an internal university app
      allow read: if true;
      
      // Create: 
      // 1. Authenticated Students can upload
      // 2. Teachers/Admins can upload too
      // 3. Status must initially be 'pending' (unless it's an Admin/Teacher uploading?)
      allow create: if isAuthenticated() 
        && request.resource.data.status == 'pending'; 

      // Update:
      // 1. Admins can do anything
      // 2. Teachers can Update Status (Approve/Reject)
      // 3. Authors (Students) can update content (title, abstract, etc)
      //    BUT Authors CANNOT change status to 'approved'
      allow update: if isAdmin() 
        || (isTeacher() && (
             // Teachers can update status and feedback
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'feedback', 'updatedAt']) 
             || resource.data.authorId == request.auth.uid // Or if they own it
           ))
        || (isOwner(resource.data.authorId) && (
             // Authors can update content but NOT status (unless it stays same)
             request.resource.data.status == resource.data.status 
             || (resource.data.status == 'draft' && request.resource.data.status == 'pending') // Draft -> Pending allowed
           ));
           
      // Delete:
      // 1. Admins
      // 2. Owners (only if status is draft or pending, maybe?)
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }
    
    // --- Comments / Notifications / etc ---
    
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isAuthenticated(); // Allow users to trigger notifications (e.g. via cloud functions usually better)
    }
  }
}