rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is signed in as themselves
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if the user has a specific role (requires reading their user doc)
    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Specialized role checks
    function isAdmin() {
      return hasRole('admin');
    }
    
    function isTeacher() {
      // Teachers must be approved to perform teacher actions
      return hasRole('teacher') && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone authenticated can read user profiles (needed for project details etc)
      allow read: if isAuthenticated();
      
      // Creation: 
      // 1. Must be the user themselves
      // 2. Cannot create an Admin account directly (must be promoted)
      // 3. Teachers start as unapproved (enforced by validation, but rules safe-guard)
      // Note: We check if the incoming data matches the constraints
      allow create: if isOwner(userId)
        && request.resource.data.role != 'admin' // Prevent signup as admin
        && (
          request.resource.data.role != 'teacher' || 
          request.resource.data.isApproved == false
        );

      // Updates:
      // 1. Admins can update any user (Promote, Approve, Deactivate)
      // 2. Users can update their own profile, BUT cannot change their Role or Approval status
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role // Cannot change own role
        && request.resource.data.isApproved == resource.data.isApproved // Cannot approve self
        && request.resource.data.isActive == resource.data.isActive // Cannot reactivate self if suspended
      );
      
      // Delete: Only Admins can delete users
      allow delete: if isAdmin();
    }

    // --- Projects Collection ---
    match /projects/{projectId} {
      // Public Read: Projects are meant to be showcased
      // Optionally restrict to authenticated if it's an internal university app
      allow read: if true;
      
      // Create: 
      // 1. Authenticated Students can upload
      // 2. Teachers/Admins can upload too
      // 3. Status must initially be 'pending' (unless it's an Admin/Teacher uploading?)
      allow create: if isAuthenticated() 
        && request.resource.data.status == 'pending'; 

      // Update:
      // 1. Admins can do anything
      // 2. Teachers can fully update projects they review (approve/reject/feedback)
      //    This is needed because approval also sets facultyId, facultyName, rating etc.
      // 3. Authors (Students) can update content but NOT freely change status
      allow update: if isAdmin()
        || isTeacher() // Teachers can update any project field during review
        || (isOwner(resource.data.authorId) && (
             // Authors can update content but NOT status (unless it stays same or draft->pending)
             request.resource.data.status == resource.data.status
             || (resource.data.status == 'draft' && request.resource.data.status == 'pending')
             || (resource.data.status == 'needsRevision' && request.resource.data.status == 'pending')
           ));

      // Delete:
      // 1. Admins
      // 2. Owners
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Activity Logs (server-side writes from approved teachers/admins) ---
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}